# Copy to .env.local for local development. On Vercel, add these in Project Settings > Environment Variables.
# Required: DATABASE_URL, ADMIN_EMAIL, ADMIN_PASSWORD (12+ characters), SESSION_SECRET (32+). Everything else can wait.

# ─── Required ──────────────────────────────────────────────────────────────────

# Postgres. On Supabase: Connect > Session pooler (port 5432) for a server that keeps running (Railway,
# a VPS); the transaction pooler (6543) only on serverless hosts like Vercel. Locally, any Postgres 15+.
DATABASE_URL=
# Direct connection (port 5432) for migrations: npm run db:migrate. Falls back to DATABASE_URL.
DIRECT_URL=

# The one dashboard login. The password needs at least 12 characters, or Mailcheap refuses to start.
# Changing either one signs out every session. Behind Cloudflare Access (below), leave the password empty.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Cloudflare Access in front of the dashboard replaces the password login. Mailcheap checks the token
# Access adds to every request, so the origin's own URL stays closed. The public paths need a Bypass
# application: see "Cloudflare Access" in the README.
# CF_ACCESS_TEAM_DOMAIN=yourteam.cloudflareaccess.com
# CF_ACCESS_AUD=

# Signs the login session and every link in your emails (unsubscribe, confirm, tracking).
# At least 32 random characters, or Mailcheap refuses to start: openssl rand -base64 48
# Changing it breaks the links in emails already sent, unless the old value moves to SESSION_SECRET_PREVIOUS.
SESSION_SECRET=
# Optional. The secret before the last rotation (32+ characters). Links signed with it keep working; sessions
# don't. Keep it as long as links in older emails should work.
# SESSION_SECRET_PREVIOUS=

# ─── App ───────────────────────────────────────────────────────────────────────

# Public URL of this app, used in email links and the archive. No trailing slash.
# On Vercel it defaults to the project's production domain; set it once you add your own domain.
APP_URL=http://localhost:3000

# Kill switch: nothing is sent unless this is exactly "true". Leave it off until SES and QStash are set up.
SENDING_ENABLED=false

# ─── Amazon SES (sending) ──────────────────────────────────────────────────────

SES_REGION=us-east-1
# IAM user keys (see the README for the policy). Vercel reserves the AWS_* names, hence SES_*.
# Locally, when these are empty, the AWS SDK uses your default credentials (~/.aws).
SES_ACCESS_KEY_ID=
SES_SECRET_ACCESS_KEY=
# Configuration set whose event destination publishes to the SNS topic below.
SES_CONFIGURATION_SET=
# SNS topic ARN that receives bounces, complaints and deliveries at /api/webhooks/ses.
SES_SNS_TOPIC_ARN=
# Configuration set other apps send with (their SES identities' default); its events fill the Transactional page.
# SES_TRANSACTIONAL_CONFIGURATION_SET=transactional

# Emails per second across all sends, 1 to 14 (default 10).
SEND_RATE_PER_SECOND=

# ─── Upstash QStash (background sending and scheduling) ────────────────────────

# From the Upstash console > QStash. QStash calls APP_URL/api/jobs/*, so APP_URL must be public.
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=
# Only for a QStash region other than the default, or a local QStash dev server (npx @upstash/qstash-cli dev).
QSTASH_URL=

# ─── Optional ──────────────────────────────────────────────────────────────────

# "Write with AI" in the campaign editor: Claude through OpenRouter formats pasted copy into the
# product's Markdown. Hidden without a key. OPENROUTER_MODEL defaults to anthropic/claude-sonnet-5.5.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Public archive (issue pages at /p/<slug>, /archive/<newsletter>, "Read online" links in emails).
# Off unless exactly "true"; each newsletter also has its own archive switch, shown only when this is on.
ARCHIVE_ENABLED=

# Archive domains (only with ARCHIVE_ENABLED=true): news.example.com=weekly serves the "weekly" newsletter's archive at that domain.
# Comma-separated for several newsletters. Point the domain at this app first. It's the safer setup:
# issue HTML then never shares the dashboard's origin, and APP_URL/archive/weekly redirects there.
ARCHIVE_HOSTS=

# Upstash Redis: rate limits shared by every server instance. Without it, the same limits are counted
# in each instance's memory, which still stops a script hammering a form.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Supabase Storage: image uploads in the editor, into a public bucket (default "uploads"). Without these,
# uploads are off; HTML and Markdown campaigns can still use images hosted anywhere.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=

# Alerts by email to ADMIN_EMAIL (spam complaints, paused sends and automations, signup floods, rate limiter
# outages), sent through SES from this address on a verified domain, e.g. Mailcheap <alerts@mail.example.com>.
# Empty: logs only.
ALERT_FROM=
# true: also email every login, new API key and send. Otherwise those are only logged.
ALERT_ACTIVITY=

# Signup email checks (Email checks page, POST /api/v1/email-check): verifymail.io's key. Empty: DeBounce's
# free disposable check stands in, after the community lists.
VERIFYMAIL_API_KEY=
